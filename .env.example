# Ruta del archivo SQLite (en Docker: /data/tracker.db)
DATABASE_URL="data/tracker.db"

# --- Mercado Libre (API oficial) ---
# Crea una app en https://developers.mercadolibre.com.mx/devcenter
# ML_REDIRECT_URI debe ser EXACTAMENTE la que registraste en la app
# ML_CLIENT_ID=""
# ML_CLIENT_SECRET=""
# ML_REDIRECT_URI="https://www.google.com/"

# --- Fases siguientes ---
# Token del bot, se obtiene con @BotFather
# TELEGRAM_BOT_TOKEN=""
# --- Visión (leer precios desde una captura) vía OpenRouter ---

# Key en https://openrouter.ai/keys (los modelos ":free" no cuestan, pero piden key)
# OPENROUTER_API_KEY=""

# Modelo con imágenes; lista de gratis: https://openrouter.ai/models?q=free
# OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"
