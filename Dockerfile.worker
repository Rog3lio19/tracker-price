# Imagen solo para el worker (revisa precios y atiende el bot de Telegram).
# La web se despliega aparte. Necesita DATABASE_URL apuntando al PostgreSQL.
FROM node:24-slim
RUN npm install -g pnpm@10.27.0
WORKDIR /app
ENV NODE_ENV=production

# tsx está en dependencies: el worker corre directo desde src/, sin build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod && pnpm store prune

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

USER node
CMD ["node", "--import", "tsx", "scripts/worker.ts"]
